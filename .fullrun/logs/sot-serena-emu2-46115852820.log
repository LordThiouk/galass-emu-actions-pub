// Garde ISA : un ISA.md ne s'écrit jamais à la main. Extrait de lifeos-hooks.ts pour être testable.
// Sans skill ISA chargé dans la session : toute écriture refusée. Avec : seul ISATool.ts (outil du skill) passe ;
// edit/write/patch directs restent refusés (règle « jamais à la main », SKILL.md ISA). ISAGate vérifie l'empreinte en HARD.

export const ISATOOL = /^\s*(?:LIFEOS_SESSION_ID=\S+\s+)?bun\s+(?:~|\$HOME|\/home\/[^\/\s]+)\/\.claude\/LIFEOS\/TOOLS\/ISATool\.ts\s[^;&|`$<>\n\r]*$/;
const ISA_IN = /ISA\.md\b/;
const BASH_WRITE = /(>>?\s*['"]?[^\s'";&|]*ISA\.md|\btee\b[^|;&]*ISA\.md|\bsed\b[^|;&]*\s-[a-zA-Z]*i|\bperl\b[^|;&]*\s-[a-zA-Z]*i|\b(cp|mv|rsync|install|ln|dd|truncate|rm|unlink|patch|git\s+(checkout|restore|apply))\b|writeFile|Bun\.write|\bcurl\b[^|;&]*\s-[a-zA-Z]*o|\bwget\b|\bopen\([^)]*['"][wa]|write_text|awk\s+-i|\bex\b|\bvim?\b|\bnano\b)/;
const isIsa = (f: any) => typeof f === "string" && /(^|\/)ISA\.md$/.test(f);

const TOOL = "bun ~/.claude/LIFEOS/TOOLS/ISATool.ts";
const FORBIDDEN = /[;&|`$<>\n\r]/;

/** Premier opérateur de shell NON quoté d'une commande (nom lisible) — ce qui casse « commande seule ». */
function unquotedOperator(cmd: string): { at: number; name: string } | null {
  let q: string | null = null;
  for (let i = 0; i < cmd.length; i++) {
    const c = cmd[i]!;
    if (q) { if (c === q) q = null; continue; }
    if (c === "'" || c === '"') { q = c; continue; }
    if (c === "&") return { at: i, name: cmd[i + 1] === "&" ? "&&" : "&" };
    if (c === "|") return { at: i, name: cmd[i + 1] === "|" ? "||" : "|" };
    if (c === ";") return { at: i, name: ";" };
    if (c === "`") return { at: i, name: "`" };
    if (c === "$" && cmd[i + 1] === "(") return { at: i, name: "$(" };
    if (c === ">") return { at: i, name: cmd[i + 1] === ">" ? ">>" : ">" };
    if (c === "<") return { at: i, name: "<" };
    if (c === "\n" || c === "\r") return { at: i, name: "saut de ligne" };
  }
  return null;
}

/** Caractères interdits placés ENTRE guillemets : le garde les refuse aussi (regex sans notion de quote). */
function quotedForbidden(seg: string): string[] {
  const out = new Set<string>();
  let q: string | null = null;
  for (const c of seg) {
    if (q) { if (c === q) q = null; else if (FORBIDDEN.test(c)) out.add(c === "\n" || c === "\r" ? "saut de ligne" : c); continue; }
    if (c === "'" || c === '"') q = c;
  }
  return [...out];
}

/** L'appel `bun …ISATool.ts <verbe> …` contenu dans une commande, coupé au premier opérateur non quoté, script normalisé en ~/.claude. */
function isaToolCall(cmd: string): string | null {
  const m = cmd.match(/\bbun\s+\S*ISATool\.ts["']?\s+(\S[\s\S]*)$/);
  if (!m) return null;
  const rest = m[1]!;
  const op = unquotedOperator(rest);
  const seg = (op ? rest.slice(0, op.at) : rest).trim();
  return seg ? `${TOOL} ${seg}` : null;
}

/** Chemin de l'ISA visé : argument de l'outil, sinon premier mot `…ISA.md` de la commande/du patch. */
function targetIsa(tool: string, a: any): string {
  const f = a?.filePath ?? a?.file_path;
  if (isIsa(f)) return f;
  const blob = String(tool === "bash" ? a?.command ?? "" : a?.patchText ?? a?.patch ?? a?.input ?? "");
  const m = blob.match(/(?:^|[\s'">=])((?:[^\s'">;&|<=]*\/)?ISA\.md)\b/);
  return m?.[1] ?? "<chemin/ISA.md>";
}

/** Gestes exacts, prêts à copier, pour le fichier visé. */
function recipes(path: string): string {
  return [
    `  ajouter du texte : ${TOOL} append ${path} --section "<Section>" --text "<texte>"`,
    `  cocher (preuve ≥ 20 car.) : ${TOOL} tick ${path} --isc ISC-<n> --evidence "<commande → sortie>"`,
    `  frontmatter : ${TOOL} set ${path} --field <champ> --value <valeur>`,
    `  correction exacte : ${TOOL} replace ${path} --old "<ancien>" --new "<nouveau>"`,
  ].join("\n");
}

const QUOTE_HINT = (chars: string[]) =>
  `Le caractère ${chars.map((c) => `« ${c} »`).join(", ")} est refusé même entre guillemets (le garde lit la commande brute). Remplace-le dans la valeur (« puis » au lieu de « ; » ou « && », « → » au lieu de « | »), ou, pour append, écris le texte dans un fichier et passe --file <fichier>.`;

export function isaGuard(tool: string, a: any, skillLoaded: boolean): string | null {
  const f = a?.filePath ?? a?.file_path; const pt = a?.patchText ?? a?.patch ?? a?.input;
  const direct = (["edit", "write", "multiedit"].includes(tool) && isIsa(f)) || (["patch", "apply_patch"].includes(tool) && typeof pt === "string" && ISA_IN.test(pt));
  const viaBash =
    (tool === "bash" && typeof a?.command === "string" && ISA_IN.test(a.command) && BASH_WRITE.test(a.command)) ||
    (tool === "bash" && typeof a?.command === "string" && /ISATool\.ts["']?\s+(scaffold|append|tick|untick|set|replace|adopt)\b/.test(a.command));
  const keyHit = [a?.filePath, a?.file_path, a?.path, a?.command, a?.pattern, a?.include].some((v: any) => typeof v === "string" && /isa-stamp-key/.test(v));
  if (keyHit) return "LifeOS ISA: la clé d'empreinte ISA n'est accessible qu'à ISATool.ts.";
  if (!direct && !viaBash) return null;
  if (viaBash && /^\s*bun\s+\S*ISATool\.ts\s+verify\s[^;&|`$<>\n\r]*$/.test(a.command)) return null; // lecture seule (audit Vera/Max)
  const path = targetIsa(tool, a);
  if (!skillLoaded) {
    const call = (viaBash && isaToolCall(a.command)) || `${TOOL} append ${path} --section "<Section>" --text "<texte>"`;
    return `LifeOS ISA: écriture d'ISA.md refusée — le skill ISA n'est pas chargé dans cette session. Fais ceci, dans l'ordre :
1. Appelle l'outil skill : skill(name="ISA") — une seule fois, il reste chargé pour la session.
2. Relance l'écriture avec UNE commande seule :
  ${call}`;
  }
  if (direct) return `LifeOS ISA: édition directe d'ISA.md refusée (jamais à la main) — l'outil pose l'empreinte vérifiée par ISAGate. Lance à la place UNE commande bash seule, par exemple :
${recipes(path)}`;
  if (!ISATOOL.test(a.command)) {
    const call = isaToolCall(a.command);
    const op = unquotedOperator(a.command);
    if (call) {
      const inQuotes = quotedForbidden(call.slice(TOOL.length));
      if (inQuotes.length) return `LifeOS ISA: écriture shell d'ISA.md refusée — ${QUOTE_HINT(inQuotes)}\nCommande à relancer, seule, une fois la valeur corrigée :\n  ${call}`;
      return `LifeOS ISA: écriture shell d'ISA.md refusée — ${op ? `l'enchaînement « ${op.name} »` : "la commande"} n'est pas autorisé : l'appel ISATool doit être la commande entière, sans chaînage ni redirection. Lance-le seul :
  ${call}
puis fais le reste (cd, rg, git…) dans des appels bash séparés.`;
    }
    return `LifeOS ISA: écriture shell d'ISA.md refusée${op ? ` (« ${op.name} »)` : ""} — un ISA.md ne s'écrit que via ISATool.ts, en commande seule, sans chaînage ni redirection. Lance, par exemple :
${recipes(path)}`;
  }
  return null;
}

